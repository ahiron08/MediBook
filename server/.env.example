# ============================================
# Doctor Appointment System - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database
# MongoDB connection string (use MongoDB Atlas for production)
MONGO_URI=your_mongodb_connection_string_here

# JWT Configuration
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_secure_jwt_secret_key_here
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# CORS Configuration
# Comma-separated list of allowed origins
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
SIGNUP_RATE_LIMIT_MAX=5

# Security Headers
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'

# Password Security
# Recommended: 12 for production (range: 10-15)
BCRYPT_SALT_ROUNDS=12

# Logging
# Levels: error, warn, info, http, debug
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Email Configuration (if used)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password_here

# API Keys (if used)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=df6ucvwym
CLOUDINARY_API_KEY=553851869162866
CLOUDINARY_API_SECRET=s1ddJAhgwBnC56RqTlVtwOI3fvQ

# File Upload (if used)
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf
